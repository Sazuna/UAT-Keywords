%R 2023pre9.conf.104055M
%A Murphy, P. C.; Cecconi, B.; Briand, C.; Aicardi, S.
%F AA (LESIA, Observatoire de Paris, Universit\'{e} PSL, Sorbonne Universit\'{e}, Universit\'{e} Paris Cit\'{e}, CNRS, 92190 Meudon, France)
   AB (LESIA, Observatoire de Paris, Universit\'{e} PSL, Sorbonne Universit\'{e}, Universit\'{e} Paris Cit\'{e}, CNRS, 92190 Meudon, France)
